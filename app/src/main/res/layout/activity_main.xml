<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F5F5F5">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MCQ Scanner &amp; Grader"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="30dp" />

    <Button
        android:id="@+id/btnLoadKey"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Upload Answer Key (JSON)"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnScanSheet"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Scan Marking Key"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/btnExportAnswers"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Export Student Answers (JSON)"
        android:layout_marginTop="10dp"
        android:backgroundTint="#2196F3"
        android:textColor="#FFFFFF"
        android:visibility="gone" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status &amp; Results:"
        android:textStyle="bold"
        android:layout_marginTop="30dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:background="#FFFFFF"
        android:padding="10dp">

        <TextView
            android:id="@+id/tvResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No data loaded."
            android:textSize="16sp"
            android:fontFamily="monospace" />
    </ScrollView>

</LinearLayout>